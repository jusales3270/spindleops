# Copie este arquivo com o nome ".env" (sem o .example) e ajuste os valores.
# No Windows: copy .env.example .env   |   No Linux/Mac: cp .env.example .env

# Porta do backend — NÃO MUDE (o dashboard espera 3002)
PORT=3002

# Intervalo de leitura das máquinas, em milissegundos (3000 = a cada 3 segundos)
POLL_INTERVAL=3000

# Senha interna entre o backend e os serviços de protocolo.
# Recomendado: troque por qualquer frase aleatória sua.
SPINDLEOPS_SERVICE_TOKEN=troque-por-uma-senha-qualquer

# (Opcional) Chave da API da Anthropic para as funções de IA do dashboard.
# Sem ela o resto do sistema funciona normalmente.
# ANTHROPIC_API_KEY=sk-ant-...

# (Opcional) Máquinas iniciais. Normalmente NÃO precisa: cadastre pelo
# dashboard em Configurações. Só é lido se o banco estiver vazio.
# MACHINES_CONFIG=[{"id":"sim-01","name":"Simulador","protocol":"simulator"}]
